# Build output — anchored to repo root so cmd/pkd/ is not ignored
/pkd
/pkd.exe
*.out

# Test artifacts
*.test
*.cover
coverage.html

# Data volumes (never commit real data)
/data/
/tmp/

# SQLite files
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Environment / secrets
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go vendor (we use go mod, not vendor) — âncora em /vendor/ para NÃO
# ignorar internal/server/web/vendor/ que contém o bundle do CKEditor
/vendor/

# Svelte build output — generated by 'cd frontend && npm run build'
# web/dist/index.html is committed as a placeholder; the generated assets/ are not
internal/server/web/dist/assets/

# Node.js
frontend/node_modules/
frontend/.vite/
