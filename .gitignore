# Build output — anchored to repo root so cmd/pkd/ is not ignored
/pkd
*.msi
/pkd.exe
*.out

# Test artifacts
*.test
*.cover
coverage.html

# Data volumes (never commit real data)
/data/
/tmp/

# SQLite files
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Environment / secrets
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go vendor (we use go mod, not vendor)
/vendor/

# Dev screenshots
mobile-*.png

# MCP browser session dumps
/.playwright-mcp/

# Memory tool logs
/.remember/logs/
/.remember/tmp/

# Svelte build output — generated by 'cd frontend && npm run build'
# web/dist/index.html is committed as a placeholder; the generated assets/ are not
internal/server/web/dist/assets/

# Node.js
frontend/node_modules/
frontend/.vite/

openwiki
graphify-out
